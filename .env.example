# =================================================================
#  B.Tech Learning Platform - Environment Configuration Example
# =================================================================

# -----------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# -----------------------------------------------------------------
# For Local SQLite:
DATABASE_URL=sqlite:///btech_platform.db

# For Supabase PostgreSQL:
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# SUPABASE_DATABASE_URL=

# -----------------------------------------------------------------
# 2. SMTP EMAIL DISPATCH (FOR REAL EMAIL OTP)
# -----------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_google_app_password
SMTP_TLS=true
SMTP_SSL=false
EMAILS_FROM_NAME=B.Tech Learning Platform
EMAILS_FROM_EMAIL=your_email@gmail.com

# -----------------------------------------------------------------
# 3. SUPABASE CLIENT & STORAGE (OPTIONAL)
# -----------------------------------------------------------------
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=btech-assets

# -----------------------------------------------------------------
# 4. SECURITY & PLATFORM SECRETS
# -----------------------------------------------------------------
SECRET_KEY=generate_a_random_secure_secret_key_here
ADMIN_EMAIL_WHITELIST=admin@btechlearn.edu
ADMIN_MASTER_KEY=BTECH_SUPER_ADMIN_2026
REQUIRE_EMAIL_OTP=true
